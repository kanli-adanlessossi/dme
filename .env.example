# Exemple de configuration. Copier en `.env` et ajuster au besoin :
#   cp .env.example .env
# Ne jamais committer de vrai `.env` (voir .gitignore).

# --- Application ---
APP_NAME=DME - Centres médicaux Togo
ENVIRONMENT=development
DEBUG=true

# --- Base de données PostgreSQL + PostGIS ---
# POSTGRES_HOST=db correspond au nom du service dans docker-compose.yml.
# POSTGRES_USER/PASSWORD servent aux migrations (propriétaire du schéma).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dme
POSTGRES_USER=dme
POSTGRES_PASSWORD=dme

# --- Authentification JWT (tâche 7.2) ---
# Secret de signature des JWT (HS256). À générer et surcharger OBLIGATOIREMENT
# hors développement (p. ex. `openssl rand -hex 32`). Ne jamais committer le vrai
# secret. La durée de vie de l'access token est dimensionnée pour couvrir une
# journée de travail hors ligne (NFR-7) ; ajustable à la réalité d'un centre.
# JWT_SECRET=changez-moi-par-un-secret-aleatoire
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TTL_SECONDS=43200
# JWT_REFRESH_TTL_SECONDS=2592000

# --- Rôle applicatif de base (tâche 4.1 / RLS tâche 4.2) ---
# La migration 0002 crée le rôle `dme_app` NON-superuser et NOBYPASSRLS. Pour que
# la RLS soit TOUJOURS appliquée (tâche 4.2), la connexion runtime de l'API doit
# utiliser ce rôle plutôt que le propriétaire du schéma. Le mot de passe de ce
# rôle n'est jamais codé en dur : positionnez-le hors bande (init SQL / secret),
# puis renseignez ici les identifiants de connexion applicative.
# APP_DB_USER=dme_app
# APP_DB_PASSWORD=changez-moi

# --- Amorçage des données de référence (tâche 6.2) ---
# Chemin du GeoJSON des 5 régions du Togo chargé au démarrage par `app.seed`.
# En conteneur, le dossier `data/` du dépôt est monté sous `/app/data` (voir
# docker-compose.yml) ; hors conteneur, le défaut `<repo>/data/togo-regions.geojson`
# s'applique et cette variable est inutile.
# REGIONS_GEOJSON_PATH=/app/data/togo-regions.geojson

# --- Amorçage des centres d'exemple pour le dev local (tâche 13) ---
# Au `docker compose up`, l'API amorce (après les régions) un platform_admin et un
# centre d'exemple par région avec un mot de passe de démonstration connu, pour
# rendre les comptes immédiatement utilisables en local. Cet amorçage est un no-op
# quand ENVIRONMENT=production. Surchargez le mot de passe de démonstration ici si
# besoin ; ne l'utilisez JAMAIS en production.
# SEED_DEV_PASSWORD=dev-password-change-me

# --- Frontend (Vite) ---
# URL de l'API consommée par le frontend.
VITE_API_URL=http://localhost:8000
